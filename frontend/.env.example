# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env.local for local overrides.
# Only VITE_* variables are exposed to the browser - never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the API. Leave empty to use the Vite dev proxy (recommended
# locally) or the same origin in production behind a reverse proxy.
VITE_API_BASE_URL=

# Target the dev-server proxy forwards /api and /health to.
VITE_API_PROXY_TARGET=http://localhost:8000

# Shown in the UI header.
VITE_APP_NAME=AI Food Freshness Monitoring Platform

# Google OAuth client ID for "Continue with Google" (Consumer sign-in).
# A client ID is NOT a secret; it is safe to expose in the browser bundle.
# Leave empty to hide the Google button. Create one at:
# https://console.cloud.google.com -> Credentials -> OAuth client ID (Web).
VITE_GOOGLE_CLIENT_ID=