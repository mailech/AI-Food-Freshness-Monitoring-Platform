PROJECT_NAME="FreshLens"
API_V1_STR="/api/v1"
SECRET_KEY="change_this_to_a_secure_random_string_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=freshlens_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/freshlens_db

# MongoDB Settings
MONGODB_USER=mongo_admin
MONGODB_PASSWORD=mongo_password
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=freshlens_mongo
MONGODB_URL=mongodb://mongo_admin:mongo_password@localhost:27017/freshlens_mongo?authSource=admin

# AI Model Settings
MODEL_PATH=ml/models/freshness_model.pt
MODEL_CONFIDENCE_THRESHOLD=0.60
MODEL_DEVICE=auto
MODEL_VERSION=1.0.0
MODEL_NAME=FreshNet-CNN
MAX_IMAGE_SIZE_BYTES=5242880

# Freshness Scoring Weights (must sum to exactly 1.0)
FRESHNESS_VISUAL_WEIGHT=0.40
FRESHNESS_STORAGE_WEIGHT=0.25
FRESHNESS_SHELF_WEIGHT=0.20
FRESHNESS_AGE_WEIGHT=0.15
