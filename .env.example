# ============================================================
# AI Food Freshness Monitoring Platform — Environment Template
# Copy this file to .env and fill in your values.
# ============================================================

# ─────────────────────────────────────
# Security
# ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-strong-random-secret-key

# ─────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=food_freshness_db

# ─────────────────────────────────────
# MongoDB
# ─────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=food_freshness_db

# ─────────────────────────────────────
# Redis / Celery
# ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─────────────────────────────────────
# Upload Storage
# ─────────────────────────────────────
UPLOAD_DIR=uploads

# ─────────────────────────────────────
# Optional: AI model override paths
# ─────────────────────────────────────
# CNN_MODEL_PATH=models/food_freshness_cnn.pth
# REGRESSOR_MODEL_PATH=models/shelf_life_regressor.pth
