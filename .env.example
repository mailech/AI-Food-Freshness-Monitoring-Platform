# Application
PROJECT_NAME=FreshLens

# Authentication

ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_USER=postgres

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=freshlens_db


# MongoDB
MONGODB_USER=mongo_admin

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=freshlens_mongo
MONGODB_URL=mongodb://mongo_admin:your_mongodb_password@localhost:27017/freshlens_mongo?authSource=admin

# AI Model
DEMO_MODE=true
MODEL_PATH=ml/models/freshness_model.pt
MODEL_CONFIDENCE_THRESHOLD=0.60
MODEL_DEVICE=auto
MODEL_VERSION=1.0.0
MODEL_NAME=FoodFreshnessCNN
MAX_IMAGE_SIZE_BYTES=5242880

# Freshness Scoring (Weights must sum to 1.0)
FRESHNESS_VISUAL_WEIGHT=0.40
FRESHNESS_STORAGE_WEIGHT=0.25
FRESHNESS_SHELF_WEIGHT=0.20
FRESHNESS_AGE_WEIGHT=0.15
