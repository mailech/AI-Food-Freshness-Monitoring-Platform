# ===========================================================================
# AI Food Freshness Monitoring Platform - backend environment
#
#   cp .env.example .env      then edit as needed
#
# NEVER commit a real .env. Every value below is a safe development default.
# ===========================================================================

# ---------------------------------------------------------------- application
APP_NAME=AI Food Freshness Monitoring Platform
APP_VERSION=1.0.0
# development | testing | staging | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# true emits one JSON object per line (good for log shippers)
LOG_JSON=false

# ------------------------------------------------------------------- database
# PostgreSQL is the primary database. The default below is a zero-setup SQLite
# file so the project runs immediately; switch to PostgreSQL for real use.
#
#   DATABASE_URL=postgresql+psycopg2://freshness:freshness_dev_password@localhost:5432/freshness
#
# Leave blank to use backend/freshness.sqlite3.
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------ jwt
# MUST be replaced with a long random value in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# -------------------------------------------------------------- oauth2 (opt-in)
# Local JWT auth is fully functional without any of these. Setting
# OAUTH_ENABLED=true only advertises the provider to the UI; supply real
# credentials to complete the flow.
OAUTH_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:5173/oauth/callback

# ----------------------------------------------------------------------- cors
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000

# ----------------------------------------------------------------- rate limit
# In-process sliding window: correct for one worker, adequate for demos.
# Use a Redis-backed store for multi-instance deployments.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# -------------------------------------------------------------------- uploads
# local | s3 | azure  (cloud backends fall back to local if misconfigured)
STORAGE_BACKEND=local
UPLOAD_DIR=
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png

# --- AWS S3 (only when STORAGE_BACKEND=s3; requires `pip install boto3`) ---
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=food-images/

# --- Azure Blob (only when STORAGE_BACKEND=azure) ---
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_CONNECTION_STRING=

# ------------------------------------------------------------------------- ml
# true  -> transparent OpenCV / rule baselines. Results are labelled
#          "Demo AI Analysis (baseline)" and NO accuracy is claimed.
# false -> load trained artefacts from MODEL_PATH. Any artefact that is
#          missing falls back to its baseline and the fallback is reported at
#          GET /api/v1/system/models.
DEMO_MODE=true
MODEL_PATH=
FRESHNESS_MODEL_FILE=freshness_classifier.joblib
SHELF_LIFE_MODEL_FILE=shelf_life_regressor.joblib
SPOILAGE_MODEL_FILE=spoilage_yolo.pt
FOOD_CLASSIFIER_MODEL_FILE=food_classifier.joblib
# Longest edge the analysis pipeline resizes to (px).
IMAGE_ANALYSIS_SIZE=384

# ------------------------------------------------- freshness scoring model
# The specification's weighted model. Must sum to 1.0.
WEIGHT_VISUAL=0.40
WEIGHT_STORAGE=0.25
WEIGHT_SHELF_LIFE=0.20
WEIGHT_PRODUCT_AGE=0.15

# Score -> category thresholds (inclusive lower bounds).
THRESHOLD_FRESH=90
THRESHOLD_GOOD=75
THRESHOLD_ACCEPTABLE=60
THRESHOLD_NEAR_SPOILAGE=30

# -------------------------------------------------------------------- alerting
EXPIRY_WARNING_DAYS=3
SHELF_LIFE_WARNING_DAYS=2
# Deviation inside the tolerance produces WARNING rather than NON_COMPLIANT.
STORAGE_TEMP_TOLERANCE_C=1.0
STORAGE_HUMIDITY_TOLERANCE_PCT=5.0

# ------------------------------------------------------------------- reporting
REPORT_DIR=
REPORT_ORGANISATION=AI Food Freshness Monitoring Platform

# ---------------------------------------------------------------- sample data
# Where `python -m app.seed` writes the generated demo images. Must be writable.
# Defaults to <repo>/data/sample; containers set /app/data/sample.
SAMPLE_DIR=

# --------------------------------------------------------------------- sensors
# mock -> deterministic simulated readings, no hardware required (default)
# mqtt -> subscribe to a broker (requires `pip install paho-mqtt`)
SENSOR_PROVIDER=mock
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=freshness/sensors/#
MQTT_USERNAME=
MQTT_PASSWORD=

# ----------------------------------------------------------------------- email
# Optional architecture. Notifications work in-app without SMTP.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@freshness.local

# ------------------------------------------------------------------------ seed
# Password given to every account created by `python -m app.seed`.
# Development only - never reuse for a real deployment.
SEED_DEMO_PASSWORD=Demo@1234
