# Application
APP_NAME=AI Food Freshness Monitoring Platform API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed to call this API from a browser.
# Use the deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection URL. Replace the password locally; do not commit it.
# Leave this unset until PostgreSQL is ready. Example only -- not a real secret.
DATABASE_URL=postgresql+psycopg://postgres:replace_with_your_password@localhost:5432/food_monitoring

# Authentication. Generate a long random value for your local backend/.env.
# Never commit the real value.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Freshness image uploads are stored outside the application package by default.
FRESHNESS_UPLOAD_DIR=uploads/freshness
FRESHNESS_MAX_UPLOAD_BYTES=5242880
