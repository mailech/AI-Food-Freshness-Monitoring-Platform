PROJECT_NAME="FreshLens"
API_V1_STR="/api/v1"
SECRET_KEY="change_this_to_a_secure_random_string_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=freshlens_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/freshlens_db

# MongoDB Settings
MONGODB_USER=mongo_admin
MONGODB_PASSWORD=mongo_password
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=freshlens_mongo
MONGODB_URL=mongodb://mongo_admin:mongo_password@localhost:27017/freshlens_mongo?authSource=admin

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# InfluxDB Settings
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=freshlens_super_secret_token_1234567890
INFLUXDB_ORG=freshlens_org
INFLUXDB_BUCKET=freshlens_sensor_bucket
