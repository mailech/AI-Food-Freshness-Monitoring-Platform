# Backend environment variables (fill before running)
DATABASE_URL=postgresql+psycopg2://ffp:ffp@localhost:5432/ffpdb
MONGO_URL=mongodb://localhost:27017
MONGO_DB=ffp
JWT_SECRET=generate-a-random-64-char-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
