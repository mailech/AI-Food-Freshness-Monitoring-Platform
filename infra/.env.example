# Copy this file to .env and fill in real values before running docker-compose

# Google OAuth2 — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Override the JWT secret in production (min 32 random chars)
JWT_SECRET=dev-secret-change-me-in-production
